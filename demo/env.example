# === Docker Image Names ===

ANNOTATOR_IMAGE_NAME_FULL_API=annotator-api-local # Name for the locally built backend image. Default: annotator-api-local

ANNOTATOR_IMAGE_NAME_FULL_STATIC=annotator-static-local # Name for the locally built frontend image. Default: annotator-static-local


# === Linux File Permissions ===

ANNOTATOR_BACKEND_UID=1000 # User ID matching host user to prevent volume permission issues. Default: 1000

ANNOTATOR_BACKEND_GID=1000 # Group ID matching host user to prevent volume permission issues. Default: 1000


# === Django Core Settings ===

ANNOTATOR_BACKEND_DEBUG=True # Enables debug mode and stack traces in browser. Default: True

ANNOTATOR_BACKEND_SECRET_KEY=test-backend-sk # Insecure dummy secret key for local development. Default: test-backend-sk

ANNOTATOR_BACKEND_ALLOWED_HOSTS=localhost,127.0.0.1 # Allowed host headers for Django. Default: localhost,127.0.0.1

ANNOTATOR_BACKEND_CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://localhost:8000 # Trusted origins for CSRF protection. Default: http://localhost:8080,http://localhost:8000


# === Django App Specific ===

ANNOTATOR_BACKEND_TOKEN_PER_USER=5 # Maximum authentication tokens per user. Default: 5

ANNOTATOR_BACKEND_MAX_FILE_SIZE=2147483648 # Max upload file size in bytes. Default: 2147483648 (2 GB)


# === Django Superuser ===

ANNOTATOR_BACKEND_SU_NAME=admin # Automatic admin username created on startup. Default: admin

ANNOTATOR_BACKEND_SU_EMAIL=admin@localhost.local # Automatic admin email. Default: admin@localhost.local

ANNOTATOR_BACKEND_SU_PASSWORD=admin # Automatic admin password. Default: admin


# === Gunicorn / Server Settings ===

ANNOTATOR_BACKEND_TIMEOUT=120 # Server timeout in seconds. Default: 120

ANNOTATOR_BACKEND_NUM_WORKERS=2 # Number of Gunicorn worker processes. Default: 2


# === Frontend Settings ===

ANNOTATOR_API_BASE=http://localhost:3000/api # Base URL of the backend API. Default: http://localhost:3000/api

ANNOTATOR_FRONTEND_TITLE=3D Annotator # Browser tab title. Default: 3D Annotator

ANNOTATOR_FRONTEND_DEBUG=true # Enables frontend debug mode. Default: true

ANNOTATOR_FRONTEND_PORT=8000 # Local port for the frontend UI. Default: 8000

ANNOTATOR_BACKEND_PORT=3000 # Local port for the backend API. Default: 3000
